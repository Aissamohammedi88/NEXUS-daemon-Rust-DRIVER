cat << 'SCRIPT_EOF' > /tmp/nexus_guardian.sh && chmod +x /tmp/nexus_guardian.sh && sudo /tmp/nexus_guardian.sh install
#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
# NEXUS KERNEL GUARDIAN v3.0 — SMART EDITION
# ═══════════════════════════════════════════════════════════════════════════════
set -uo pipefail

readonly APP_NAME="nexus-guardian"
readonly APP_VERSION="3.0.0"
readonly INSTALL_DIR="/opt/${APP_NAME}"
readonly CONFIG_DIR="/etc/${APP_NAME}"
readonly SYSCTL_FILE="/etc/sysctl.d/99-${APP_NAME}.conf"
readonly SYSTEMD_FILE="/etc/systemd/system/${APP_NAME}.service"
readonly LOG_FILE="/var/log/${APP_NAME}.log"
readonly RUST_SRC="${INSTALL_DIR}/src/main.rs"
readonly RUST_BIN="${INSTALL_DIR}/bin/guardian_core"
readonly BACKUP_ROOT="/var/backups/${APP_NAME}"
readonly STATE_DIR="/var/lib/${APP_NAME}"

readonly C_R='\033[1;31m'; readonly C_G='\033[1;32m'; readonly C_Y='\033[1;33m'
readonly C_C='\033[1;36m'; readonly C_M='\033[1;35m'; readonly C_W='\033[1;37m'
readonly C_N='\033[0m'

log_info() { echo -e "${C_C}[INFO]${C_N} $*"; }
log_ok()   { echo -e "${C_G}[ OK ]${C_N} $*"; }
log_warn() { echo -e "${C_Y}[WARN]${C_N} $*"; }
log_err()  { echo -e "${C_R}[ERR ]${C_N} $*" >&2; }

on_error() { log_warn "Commande en échec — ligne $1 (code $?). Poursuite."; }
trap 'on_error $LINENO' ERR

pause_exit() {
    if [[ -t 0 ]]; then read -rp "Appuyez sur Entrée pour quitter..." || true; fi
    exit "${1:-0}"
}
die() { log_err "$*"; pause_exit 1; }

print_banner() {
    echo -e "${C_M}"
    cat << 'EOF'
    ███╗   ██╗███████╗██╗  ██╗██╗   ██╗███████╗
    ████╗  ██║██╔════╝╚██╗██╔╝██║   ██║██╔════╝
    ██╔██╗ ██║█████╗   ╚███╔╝ ██║   ██║███████╗
    ██║╚██╗██║██╔══╝   ██╔██╗ ██║   ██║╚════██║
    ██║ ╚████║███████╗██╔╝ ██╗╚██████╔╝███████║
    ╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝
      K E R N E L   G U A R D I A N
EOF
    echo -e "${C_N}  v${APP_VERSION} | Smart Edition\n"
}

require_root() {
    local uid="${EUID:-$(id -u)}"
    [[ "$uid" -eq 0 ]] && return 0
    local elev=""
    if command -v sudo >/dev/null 2>&1; then elev="sudo -E";
    elif command -v doas >/dev/null 2>&1; then elev="doas"; fi
    if [[ -n "$elev" ]]; then
        log_info "UID $uid détecté — réexécution via ${elev%% *}..."
        exec $elev bash "$0" "$@"
    fi
    die "Root requis."
}

backup_file() {
    local target="$1"; [[ -e "$target" ]] || return 0
    local stamp dir; stamp="$(date +%Y%m%d-%H%M%S)"; dir="${BACKUP_ROOT}/${stamp}"
    mkdir -p "$dir"
    cp -a "$target" "${dir}/$(basename "$target")" 2>/dev/null && log_info "Sauvegarde : ${dir}/$(basename "$target")"
}
safe_write() { local target="$1"; backup_file "$target"; mkdir -p "$(dirname "$target")"; cat > "$target"; }

cleanup_background() {
    local main_pid=""
    if systemctl is-active --quiet "${APP_NAME}.service" 2>/dev/null; then
        main_pid="$(systemctl show -p MainPID --value "${APP_NAME}.service" 2>/dev/null || echo "")"
    fi
    local killed=0 pid
    while read -r pid; do
        [[ -z "$pid" || "$pid" == "$main_pid" || "$pid" == "$$" ]] && continue
        kill -TERM "$pid" 2>/dev/null || true; killed=$((killed + 1))
    done < <(pgrep -f "$RUST_BIN" 2>/dev/null || true)
    [[ $killed -gt 0 ]] && { sleep 2; while read -r pid; do [[ -z "$pid" || "$pid" == "$main_pid" ]] && continue; kill -KILL "$pid" 2>/dev/null || true; done < <(pgrep -f "$RUST_BIN" 2>/dev/null || true); }
    systemctl reset-failed "${APP_NAME}.service" 2>/dev/null || true
}

check_dependencies() {
    command -v systemctl >/dev/null 2>&1 || die "systemd indisponible."
    if ! command -v rustc >/dev/null 2>&1; then
        log_warn "rustc absent — installation."
        apt-get update -qq || true
        apt-get install -y -qq rustc || die "rustc introuvable."
    fi
}

generate_rust_source() {
    mkdir -p "$(dirname "$RUST_SRC")" "$(dirname "$RUST_BIN")" "$STATE_DIR"
    safe_write "$RUST_SRC" << 'RUST_EOF'
use std::env;
use std::fs::{self, OpenOptions};
use std::io::Write;
use std::process::Command;
use std::thread;
use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};

const POLL_INTERVAL_MS: u64 = 2000;
const ALERTS_BEFORE_ACTION: u32 = 2;
const ACTION_COOLDOWN_SECS: u64 = 60;
const LOG_PATH: &str = "/var/log/nexus-guardian.log";
const PROTECTED_PROCS: &[&str] = &["systemd", "init", "Xorg", "cinnamon", "dbus-daemon", "gnome-shell", "pulseaudio", "pipewire"];

fn env_f64(key: &str, default: f64) -> f64 { env::var(key).ok().and_then(|v| v.parse().ok()).unwrap_or(default) }

fn log(msg: &str) {
    let ts = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_secs()).unwrap_or(0);
    let line = format!("[{}] {}\n", ts, msg);
    print!("{}", line);
    if let Ok(mut f) = OpenOptions::new().create(true).append(true).open(LOG_PATH) { let _ = f.write_all(line.as_bytes()); }
}

fn read_psi(resource: &str) -> Option<f64> {
    let content = fs::read_to_string(format!("/proc/pressure/{}", resource)).ok()?;
    for line in content.lines() {
        if line.starts_with("some") {
            for field in line.split_whitespace() {
                if let Some(v) = field.strip_prefix("avg10=") { return v.parse::<f64>().ok(); }
            }
        }
    }
    None
}

fn read_loadavg() -> f64 {
    fs::read_to_string("/proc/loadavg").ok().and_then(|c| c.split_whitespace().next().map(str::to_string)).and_then(|v| v.parse::<f64>().ok()).unwrap_or(0.0)
}

fn is_kernel_thread(pid: u32) -> bool { fs::read(format!("/proc/{}/cmdline", pid)).map(|c| c.iter().all(|b| *b == 0)).unwrap_or(true) }

fn find_top_processes(limit: usize) -> Vec<(u32, String, u64)> {
    let mut procs = Vec::new();
    if let Ok(entries) = fs::read_dir("/proc") {
        for entry in entries.flatten() {
            let Some(name) = entry.file_name().to_str().map(str::to_string) else { continue };
            let Ok(pid) = name.parse::<u32>() else { continue };
            if is_kernel_thread(pid) { continue; }
            if let Ok(content) = fs::read_to_string(entry.path().join("stat")) {
                let parts: Vec<&str> = content.split_whitespace().collect();
                if parts.len() > 14 {
                    let comm = parts[1].trim_matches(|c| c == '(' || c == ')').to_string();
                    // Ignorer les processus protégés
                    if PROTECTED_PROCS.iter().any(|p| comm.contains(p)) { continue; }
                    let utime: u64 = parts[13].parse().unwrap_or(0);
                    let stime: u64 = parts[14].parse().unwrap_or(0);
                    procs.push((pid, comm, utime + stime));
                }
            }
        }
    }
    procs.sort_by(|a, b| b.2.cmp(&a.2));
    procs.into_iter().take(limit).collect()
}

fn renice_process(pid: u32, name: &str) {
    log(&format!("⚡ ACTION : Renice PID {} ({})", pid, name));
    let _ = Command::new("renice").args(["+19", "-p", &pid.to_string()]).output();
}

fn drop_caches() {
    log("⚡ ACTION : Libération des caches mémoire");
    let _ = Command::new("sync").output();
    if let Ok(mut f) = OpenOptions::new().write(true).open("/proc/sys/vm/drop_caches") { let _ = f.write_all(b"3"); }
}

fn main() {
    let cpu_th = env_f64("GUARDIAN_CPU_THRESHOLD", 20.0);
    let mem_th = env_f64("GUARDIAN_MEM_THRESHOLD", 10.0);
    let io_th  = env_f64("GUARDIAN_IO_THRESHOLD", 15.0);

    log("==============================================================");
    log("  NEXUS GUARDIAN v3.0 SMART CORE DÉMARRÉ");
    log(&format!("  Seuils CPU={:.1} MEM={:.1} IO={:.1}", cpu_th, mem_th, io_th));
    log("  Processus protégés : systemd, Xorg, cinnamon, dbus...");
    log("==============================================================");

    let mut alerts = 0;
    let mut last_action = Instant::now() - Duration::from_secs(ACTION_COOLDOWN_SECS);
    let self_pid = std::process::id();

    loop {
        let cpu = read_psi("cpu").unwrap_or_else(|| read_loadavg() * 10.0);
        let mem = read_psi("memory").unwrap_or(0.0);
        let io  = read_psi("io").unwrap_or(0.0);

        let critical = cpu > cpu_th || mem > mem_th || io > io_th;

        if critical {
            alerts += 1;
            if alerts >= ALERTS_BEFORE_ACTION {
                if last_action.elapsed() < Duration::from_secs(ACTION_COOLDOWN_SECS) {
                    alerts = 0;
                } else {
                    log(&format!("🚨 CRITIQUE : CPU({:.1}) MEM({:.1}) IO({:.1})", cpu, mem, io));
                    for (pid, name, _) in find_top_processes(3) {
                        if pid != 1 && pid != self_pid { renice_process(pid, &name); }
                    }
                    if mem > mem_th { drop_caches(); }
                    last_action = Instant::now();
                    alerts = 0;
                }
            }
        } else {
            alerts = 0;
        }
        thread::sleep(Duration::from_millis(POLL_INTERVAL_MS));
    }
}
RUST_EOF
}

compile_rust_daemon() {
    log_info "Compilation (LTO + Strip)..."
    local tmp="${RUST_BIN}.build.$$"
    # Flags d'optimisation ultimes
    if ! rustc -C opt-level=3 -C lto -C strip=symbols -C target-cpu=native "$RUST_SRC" -o "$tmp"; then
        rm -f "$tmp" 2>/dev/null || true; return 1
    fi
    backup_file "$RUST_BIN"
    mv -f "$tmp" "$RUST_BIN"; chmod +x "$RUST_BIN"
    log_ok "Daemon compilé : $RUST_BIN ($(du -h "$RUST_BIN" | cut -f1))"
    return 0
}

apply_sysctl() {
    log_info "Détection du type de disque pour Swappiness..."
    local swappiness=10
    if ! lsblk -d -o rota | grep -q "0"; then
        log_warn "HDD détecté — Swappiness ajusté à 30 pour éviter les freezes d'écriture."
        swappiness=30
    else
        log_info "SSD/NVMe détecté — Swappiness optimisé à 10."
    fi

    safe_write "$SYSCTL_FILE" << SYSCTL_EOF
# NEXUS GUARDIAN - tuning noyau SMART
vm.swappiness = $swappiness
vm.vfs_cache_pressure = 50
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
vm.min_free_kbytes = 65536
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq
kernel.sched_rt_runtime_us = 950000
SYSCTL_EOF
    sysctl -p "$SYSCTL_FILE" >/dev/null 2>&1 && log_ok "Paramètres noyau appliqués." || log_warn "Certains paramètres non supportés."
}

tune_io_scheduler() {
    local is_ssd=0
    if [[ -f /sys/block/sda/queue/rotational ]] && [[ "$(cat /sys/block/sda/queue/rotational 2>/dev/null)" == "0" ]]; then is_ssd=1; fi
    [[ -d /sys/block/nvme0n1 ]] && is_ssd=1
    for disk in /sys/block/sd*/queue/scheduler /sys/block/nvme*/queue/scheduler; do
        [[ -f "$disk" ]] || continue
        if [[ $is_ssd -eq 1 ]]; then echo "none" > "$disk" 2>/dev/null || true; else echo "mq-deadline" > "$disk" 2>/dev/null || true; fi
    done
    for cpu in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [[ -f "$cpu" ]] || continue; echo "performance" > "$cpu" 2>/dev/null || true
    done
    log_ok "Ordonnanceurs optimisés."
}

install_systemd_service() {
    safe_write "$SYSTEMD_FILE" << SYSTEMD_EOF
[Unit]
Description=Nexus Kernel Guardian (Smart Anti-Freeze)
After=network.target
[Service]
Type=simple
ExecStart=${RUST_BIN}
Restart=always
RestartSec=5s
Nice=-15
IOSchedulingClass=best-effort
IOSchedulingPriority=4
ProtectSystem=strict
ReadWritePaths=/var/log
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=false
ProtectControlGroups=false
Environment=GUARDIAN_CPU_THRESHOLD=20
Environment=GUARDIAN_MEM_THRESHOLD=10
Environment=GUARDIAN_IO_THRESHOLD=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=${APP_NAME}
[Install]
WantedBy=multi-user.target
SYSTEMD_EOF
    systemctl daemon-reload
    systemctl enable "${APP_NAME}.service" >/dev/null 2>&1 || true
}

cmd_install() {
    print_banner; require_root; check_dependencies
    mkdir -p "$INSTALL_DIR" "$CONFIG_DIR" "$STATE_DIR" "$BACKUP_ROOT" "$(dirname "$LOG_FILE")"
    cleanup_background; generate_rust_source
    if ! compile_rust_daemon; then die "Compilation échouée."; fi
    apply_sysctl; tune_io_scheduler; install_systemd_service
    systemctl restart "${APP_NAME}.service"; sleep 2
    if systemctl is-active --quiet "${APP_NAME}.service"; then
        log_ok "══════════════════════════════════════════════════════════════"
        log_ok " INSTALLATION RÉUSSIE. MODE SMART ACTIF."
        log_ok "══════════════════════════════════════════════════════════════"
    else
        log_err "Échec du démarrage."; journalctl -u "${APP_NAME}.service" --no-pager | tail -n 10
    fi
    pause_exit 0
}

main() {
    local cmd="${1:-install}"
    case "$cmd" in
        install) cmd_install ;;
        uninstall) log_warn "Désinstallation non destructive..."; systemctl stop "${APP_NAME}.service" 2>/dev/null || true; systemctl disable "${APP_NAME}.service" 2>/dev/null || true; mv -f "$SYSTEMD_FILE" "${SYSTEMD_FILE}.disabled.$(date +%s)" 2>/dev/null || true; systemctl daemon-reload; pause_exit 0 ;;
        *) echo "Usage: $0 {install|uninstall}"; exit 1 ;;
    esac
}
main "$@"
SCRIPT_EOF
